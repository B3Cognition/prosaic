    "@types/node": "20.14.9",
    "@types/yargs": "17.0.32",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.2",
    "typescript": "5.5.3"
  }
