{
  "schemaVersion": 1,
  "ontologyId": "release-evidence",
  "concepts": {
    "candidate": "A release candidate under review.",
    "receipt": "An observed verification receipt.",
    "private-policy": "An internal policy for a restricted workflow.",
    "unattached": "An unused concept."
  },
  "relations": [
    {"source": "receipt", "predicate": "verifies", "target": "candidate"},
    {"source": "private-policy", "predicate": "governs", "target": "candidate"},
    {"source": "receipt", "predicate": "mentions", "target": "unattached"}
  ],
  "agents": {"reviewer": ["candidate"], "private-reviewer": ["private-policy"]},
  "tools": {"read_receipt": ["receipt"], "read_policy": ["private-policy"]}
}
